{
  "name": "gdrive-pdftotext",
  "version": "1.1.2",
  "description": "Extract text from google drive pdf",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsup index.ts --format cjs,esm --target node22 --platform node --dts --clean",
    "dev": "npm run dev-sample",
    "dev-sample": "npm run build && node sample/index.cjs",
    "lint": "tsc",
    "test": "npm run build && node --test test/*.test.cjs",
    "prepack": "npm run build",
    "release": "npm run build && changeset publish"
  },
  "keywords": [
    "google",
    "drive",
    "pdf",
    "extract",
    "download"
  ],
  "author": "Alec Blance",
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@types/node": "^22.20.5",
    "tsup": "^8.0.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "pdfjs-dist": "^6.5.438"
  }
}
